<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Jellyfin.Plugin.ReleaseDateAdded</RootNamespace>
    <AssemblyName>Jellyfin.Plugin.ReleaseDateAdded</AssemblyName>
    <AssemblyVersion>1.2.0.0</AssemblyVersion>
    <FileVersion>1.2.0.0</FileVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <!-- Normal build: reference Jellyfin 12.0 from NuGet (then works on all 12.x). -->
  <ItemGroup Condition="'$(JellyfinStubs)' == ''">
    <PackageReference Include="Jellyfin.Controller" Version="12.0.0">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="Jellyfin.Model" Version="12.0.0">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
  </ItemGroup>

  <!-- Offline build: point JellyfinStubs to a folder with Jellyfin DLLs (e.g. from your server). -->
  <ItemGroup Condition="'$(JellyfinStubs)' != ''">
    <Reference Include="$(JellyfinStubs)/MediaBrowser.Common.dll" Private="false" />
    <Reference Include="$(JellyfinStubs)/MediaBrowser.Controller.dll" Private="false" />
    <Reference Include="$(JellyfinStubs)/MediaBrowser.Model.dll" Private="false" />
    <Reference Include="$(JellyfinStubs)/Jellyfin.Data.dll" Private="false" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Configuration\configPage.html" />
    <EmbeddedResource Include="Configuration\configPage.html" />
  </ItemGroup>

</Project>
